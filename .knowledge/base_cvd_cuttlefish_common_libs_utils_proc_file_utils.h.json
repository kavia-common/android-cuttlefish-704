{"is_source_file": true, "format": "C++ header file", "description": "This header file declares utility functions and structures for retrieving process information from the /proc filesystem on a Linux-based system. It includes functions to extract process info, collect PIDs based on various criteria, and access process-specific details like command line args, executable path, environment variables, and parent process IDs.", "external_files": ["/sys/types.h", "/unistd.h", "common/libs/utils/result.h"], "external_methods": ["getuid()"], "published": ["ProcInfo", "ExtractProcInfo", "CollectPids", "CollectPidsByExecName", "CollectPidsByExecPath", "CollectPidsByArgv0", "OwnerUid", "GetCmdArgs", "GetExecutablePath", "GetEnvs", "Ppid"], "classes": [{"name": "ProcInfo", "description": "Structure containing information about a process, including pid, ownership, executable path, environment variables, and command line arguments."}], "methods": [{"name": "ExtractProcInfo", "description": "Retrieves detailed process information for a given pid."}, {"name": "CollectPids", "description": "Collects all process IDs owned by a specific user."}, {"name": "CollectPidsByExecName", "description": "Collects process IDs with a specific executable name owned by a user."}, {"name": "CollectPidsByExecPath", "description": "Collects process IDs with a specific executable path owned by a user."}, {"name": "CollectPidsByArgv0", "description": "Collects process IDs where argv[0] matches expected value and owned by a user."}, {"name": "OwnerUid", "description": "Retrieves the UID of the owner of a process."}, {"name": "GetCmdArgs", "description": "Retrieves command line arguments for a process."}, {"name": "GetExecutablePath", "description": "Retrieves the executable path for a process."}, {"name": "GetEnvs", "description": "Retrieves environment variables of a process."}, {"name": "Ppid", "description": "Retrieves the parent process ID of a given process."}], "calls": ["getuid()"], "search-terms