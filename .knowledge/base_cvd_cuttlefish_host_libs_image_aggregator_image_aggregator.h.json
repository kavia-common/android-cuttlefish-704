{"is_source_file": true, "format": "C++ header file", "description": "This header defines functions and data structures for manipulating disk images and creating composite disk formats, overlays, and aggregations used in virtualization environments (crosvm and QEMU). It includes definitions for image partition types and functions to aggregate images, create composite disks with single or multiple images, and generate qcow overlays.", "external_files": ["<string>", "<vector>"], "external_methods": ["AlignToPartitionSize"], "published": ["AggregateImage", "CreateCompositeDisk", "CreateQcowOverlay", "ImagePartition", "MultipleImagePartition", "ImagePartitionType"], "classes": [{"name": "ImagePartition", "description": "Represents a disk image partition with label, file path, type, and read-only status."}, {"name": "MultipleImagePartition", "description": "Represents a partition with multiple image file paths, label, type, and read-only flag."}], "methods": [{"name": "AlignToPartitionSize", "description": "Aligns a given size to the partition size boundary."}, {"name": "AggregateImage", "description": "Combines multiple disk image partitions into a single raw disk file with a GUID Partition Table."}, {"name": "CreateCompositeDisk", "description": "Creates a composite disk from a set of partitions, with header and footer files, and generates a specification file."}, {"name": "CreateCompositeDisk", "description": "Overloaded function to create a composite disk with multiple images per partition."}, {"name": "CreateQcowOverlay", "description": "Generates a qcow overlay backed by a specified implementation file, enabling snapshot-like overlays."}], "calls": ["AlignToPartitionSize", "AggregateImage", "CreateCompositeDisk", "CreateQcowOverlay"], "search-terms": ["disk image manipulation", "composite disk", "qcow overlay", "partition types", "crosvm", "QEMU", "disk aggregation"], "state": 2, "file_id": 650, "knowledge_revision": 2073, "git_revision": "0629c5b738da66075641dec6d